{
  "name": "@coiggahou2002/pi-task-dag",
  "version": "0.2.0-alpha.1",
  "description": "Visual task DAG with boxed nodes, directed connectors and a guarded, source-unmodified Pi sidebar.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Coiggahou2002/pi-task-dag.git"
  },
  "keywords": [
    "pi-package",
    "pi",
    "dag",
    "tasks",
    "sidebar"
  ],
  "files": [
    "extensions",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/task-dag/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit && prettier --check .",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "^22.0.0",
    "@types/pathfinding": "^0.1.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typebox": "^1.0.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "pathfinding": "^0.4.18"
  }
}
